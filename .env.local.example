NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxx

# Cron-only — used by /api/cron/digests to iterate users.
# Get from Supabase → Project Settings → API → service_role secret.
# DO NOT expose to the browser. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the Authorization header on /api/cron/digests.
# Vercel Cron sets this automatically when CRON_SECRET is configured in env.
CRON_SECRET=
